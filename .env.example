# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Pinata Configuration for Capsules
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_token
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt

# Pinata Configuration for Vaults
NEXT_PUBLIC_PINATA_VAULT_JWT=your_pinata_vault_jwt_token
PINATA_VAULT_API_KEY=your_pinata_vault_api_key
PINATA_VAULT_API_SECRET=your_pinata_vault_api_secret
PINATA_VAULT_JWT=your_pinata_vault_jwt

# Resend API (for email notifications)
RESEND_API_KEY=your_resend_api_key
